# Next.js 服务端自然语言任务编排。复制为仓库根目录 .env 后填写；不要提交真实密钥。
AI_API_BASE_URL=https://new.fastaicode.top/v1
AI_API_KEY=
AI_MODEL=gpt-5.6-sol
# Responses API 使用 Authorization: Bearer；留空使用模型默认思考强度。
AI_REASONING_EFFORT=
# Official GraspGenX sampling budget per object; larger batches explore more poses.
GRASPGENX_NUM_GRASPS=200
