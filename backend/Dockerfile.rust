# syntax=docker/dockerfile:1.7
FROM rust:1.97-trixie AS dora-build
RUN git clone --filter=blob:none https://github.com/dora-rs/dora.git /dora-src \
    && git -C /dora-src checkout 06254f3d3353132f1184020d693680be4733bc2c \
    && cargo build --manifest-path /dora-src/Cargo.toml --release -p dora-cli

FROM dora-build AS dora-tools-build
RUN cargo build --manifest-path /dora-src/Cargo.toml --release -p dora-replay-node

FROM dora-build AS stararm-model
WORKDIR /tmp/vendor
COPY --from=stararm_vendor ROS2_HUMBLE/src/stararm102_description ROS2_HUMBLE/src/stararm102_description
COPY --from=stararm_vendor ROS2_HUMBLE/src/stararm102_moveit_config ROS2_HUMBLE/src/stararm102_moveit_config
COPY patches/star-arm-102-fl-moveit-model.patch /tmp/model.patch
RUN git apply --ignore-space-change --ignore-whitespace /tmp/model.patch \
    && mkdir -p /model/meshes \
    && cp ROS2_HUMBLE/src/stararm102_description/urdf/stararm102_description.urdf /model/ \
    && cp ROS2_HUMBLE/src/stararm102_description/meshes/* /model/meshes/

FROM rust:1.97-trixie AS build
RUN apt-get update \
    && apt-get install --yes --no-install-recommends cmake libusb-1.0-0-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates crates
COPY nodes nodes
RUN cargo build --release --locked --workspace --exclude stararm-102-motion-node

FROM debian:13-slim
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates libudev1 libusb-1.0-0 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=dora-build /dora-src/target/release/dora /usr/local/bin/dora
COPY --from=dora-tools-build /dora-src/target/release/dora-replay-node /usr/local/bin/dora-replay-node
COPY --from=stararm-model /model /opt/robot-arm/model
COPY --from=build /src/target/release/spatial-transform-node /opt/robot-arm/bin/spatial-transform-node
COPY --from=build /src/target/release/controller-input-node /opt/robot-arm/bin/controller-input-node
COPY --from=build /src/target/release/service-status-node /opt/robot-arm/bin/service-status-node
COPY --from=build /src/target/release/stararm-102-execution-node /opt/robot-arm/bin/stararm-102-execution-node
COPY --from=build /src/target/release/web-gateway-node /opt/robot-arm/bin/web-gateway-node
