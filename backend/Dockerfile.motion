# syntax=docker/dockerfile:1.7
FROM rust:1.97-trixie AS dora-build
RUN git clone --filter=blob:none https://github.com/dora-rs/dora.git /dora-src \
    && git -C /dora-src checkout 06254f3d3353132f1184020d693680be4733bc2c \
    && cargo build --manifest-path /dora-src/Cargo.toml --release -p dora-cli

FROM moveit/moveit2:jazzy-release AS ros-base
SHELL ["/bin/bash", "-c"]
ARG TARGETARCH
ARG KASMVNC_VERSION=1.5.0
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
       curl fonts-noto-cjk git openbox \
       ros-jazzy-joint-state-topic-hardware-interface \
       ros-jazzy-moveit-ros-visualization \
       ros-jazzy-moveit-task-constructor-capabilities \
       ros-jazzy-moveit-task-constructor-core \
       ros-jazzy-moveit-task-constructor-msgs \
       ros-jazzy-moveit-task-constructor-visualization \
       ros-jazzy-rviz2 ros-jazzy-trac-ik-kinematics-plugin \
    && case "${TARGETARCH}" in \
         amd64) kasm_sha=f599fe02e2175b9817b6165f74a5d2bebdc73118dde9181ba3410963bed7ae1e ;; \
         arm64) kasm_sha=c9199cf4753208bfb69fd016a9780242bebfc43370cc38c97d61e90a3c783e04 ;; \
         *) echo "unsupported architecture ${TARGETARCH}" >&2; exit 1 ;; \
       esac \
    && curl -fsSL -o /tmp/kasmvnc.deb \
       "https://github.com/kasmtech/KasmVNC/releases/download/v${KASMVNC_VERSION}/kasmvncserver_noble_${KASMVNC_VERSION}_${TARGETARCH}.deb" \
    && echo "${kasm_sha}  /tmp/kasmvnc.deb" | sha256sum --check --strict \
    && apt-get install --yes --no-install-recommends /tmp/kasmvnc.deb \
    && rm /tmp/kasmvnc.deb \
    && rm -rf /var/lib/apt/lists/*
COPY docker/rviz-index.html /usr/share/kasmvnc/www/index.html
COPY --from=dora-build /dora-src/target/release/dora /usr/local/bin/dora

WORKDIR /tmp/vendor
COPY --from=stararm_vendor ROS2_HUMBLE/src/stararm102_description ROS2_HUMBLE/src/stararm102_description
COPY --from=stararm_vendor ROS2_HUMBLE/src/stararm102_moveit_config ROS2_HUMBLE/src/stararm102_moveit_config
COPY --from=moveit_vendor . moveit_ros/moveit_servo
COPY patches /tmp/patches
COPY ros2/stararm_102_motion_node/config/stararm102_description.srdf /tmp/stararm102_description.srdf
RUN git apply --ignore-space-change --ignore-whitespace /tmp/patches/star-arm-102-fl-moveit-model.patch \
    && git apply --ignore-space-change --ignore-whitespace /tmp/patches/star-arm-102-fl-moveit-dynamics.patch \
    && git apply --ignore-space-change --ignore-whitespace /tmp/patches/star-arm-102-fl-topic-io.patch \
    && git apply --ignore-space-change --ignore-whitespace /tmp/patches/moveit-servo-halt-pose-at-joint-bound.patch \
    && mkdir -p /opt/ros_ws/src /opt/robot-arm/model/meshes \
    && cp ROS2_HUMBLE/src/stararm102_description/urdf/stararm102_description.urdf /opt/robot-arm/model/ \
    && cp ROS2_HUMBLE/src/stararm102_description/meshes/*.STL /opt/robot-arm/model/meshes/ \
    && mv moveit_ros/moveit_servo /opt/ros_ws/src/ \
    && mv ROS2_HUMBLE/src/stararm102_description /opt/ros_ws/src/ \
    && mv ROS2_HUMBLE/src/stararm102_moveit_config /opt/ros_ws/src/ \
    && cp /tmp/stararm102_description.srdf /opt/ros_ws/src/stararm102_moveit_config/config/
WORKDIR /opt/ros_ws
RUN source /opt/ros/jazzy/setup.bash \
    && colcon build --packages-select moveit_servo stararm102_description stararm102_moveit_config \
       --cmake-args -DBUILD_TESTING=OFF \
       --event-handlers console_direct+ \
    && rm -rf /tmp/vendor /tmp/patches log
COPY ros2/stararm_102_motion_node /opt/ros_ws/src/stararm_102_motion_node
COPY ros2/stararm_102_mtc /opt/ros_ws/src/stararm_102_mtc
RUN source /opt/ros/jazzy/setup.bash \
    && source install/setup.bash \
    && colcon build --packages-select stararm_102_mtc stararm_102_motion_node \
       --cmake-args -DBUILD_TESTING=OFF \
       --event-handlers console_direct+ \
    && rm -rf log

FROM rust:1.97-trixie AS motion-build
SHELL ["/bin/bash", "-c"]
RUN apt-get update \
    && apt-get install --yes --no-install-recommends clang libclang-dev \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ros-base /opt/ros /opt/ros
COPY --from=ros-base /opt/ros_ws/install /opt/ros_ws/install
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates crates
COPY nodes nodes
RUN --mount=type=cache,id=robot-arm-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=robot-arm-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    source /opt/ros/jazzy/setup.bash \
    && source /opt/ros_ws/install/setup.bash \
    && cargo build --release --locked -p stararm-102-motion-node \
       --no-default-features --features ros-runtime \
    && cp /src/target/release/stararm-102-motion-node /stararm-102-motion-node

FROM ros-base
COPY --from=motion-build /stararm-102-motion-node /opt/robot-arm/bin/stararm-102-motion-node
COPY --chmod=755 docker/motion-entrypoint.sh /usr/local/bin/motion-entrypoint
ENTRYPOINT ["/usr/local/bin/motion-entrypoint"]
