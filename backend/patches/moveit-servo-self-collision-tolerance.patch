From aa90b0f7e67408375f73b383967ef8c9eddc8bc6 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Sat, 29 Aug 2026 14:15:49 +0800
Subject: [PATCH] Allow shallow self-collision tolerance

---
 moveit_ros/moveit_servo/src/collision_monitor.cpp | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/moveit_ros/moveit_servo/src/collision_monitor.cpp b/moveit_ros/moveit_servo/src/collision_monitor.cpp
index f1e8c8c..df151ed 100644
--- a/moveit_ros/moveit_servo/src/collision_monitor.cpp
+++ b/moveit_ros/moveit_servo/src/collision_monitor.cpp
@@ -135,7 +135,10 @@ void CollisionMonitor::checkCollisions()
       // intermediate values in this loop or they can be picked up and throw off scaling while processing
       // joint updates.
 
-      if (self_collision_result_.collision || scene_collision_result_.collision)
+      const bool self_collision_exceeds_tolerance =
+          self_collision_result_.collision &&
+          self_collision_result_.distance < -servo_params_.self_collision_proximity_threshold;
+      if (self_collision_exceeds_tolerance || scene_collision_result_.collision)
       {
         collision_velocity_scale_ = 0.0;
       }
@@ -145,7 +148,8 @@ void CollisionMonitor::checkCollisions()
 
         approaching_scene_collision =
             scene_collision_result_.distance < servo_params_.scene_collision_proximity_threshold;
-        approaching_self_collision = self_collision_result_.distance < servo_params_.self_collision_proximity_threshold;
+        approaching_self_collision = !self_collision_result_.collision &&
+                                     self_collision_result_.distance < servo_params_.self_collision_proximity_threshold;
 
         if (approaching_scene_collision)
         {
-- 
