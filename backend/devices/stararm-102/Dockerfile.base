FROM robot-arm-services-backend-base:2026.09.05-r9

ARG STARARM_ARCHIVE=https://codeload.github.com/servodevelop/Star-Arm-102/tar.gz/0896306e40891c3ee4c97228e85dd708d61326de
ARG STARARM_ARCHIVE_SHA256=a6c010a7004760ebd31071361c7c2a81edac77ede871d36db4f3bdd5567313a1

RUN apt-get update && apt-get install --yes python3 \
    && mkdir -p /opt/build/downloads
COPY backend/devices/stararm-102/patches /opt/devices/stararm-102/project/patches
COPY backend/devices/stararm-102/tools/verify-model.py /opt/devices/stararm-102/project/tools/verify-model.py
COPY backend/devices/stararm-102/docker/prepare-vendor.sh /opt/devices/stararm-102/project/docker/prepare-vendor.sh
RUN /opt/devices/stararm-102/project/docker/prepare-vendor.sh \
      "$STARARM_ARCHIVE" "$STARARM_ARCHIVE_SHA256"
