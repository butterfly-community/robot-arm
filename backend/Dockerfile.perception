# syntax=docker/dockerfile:1.7
FROM rust:1.97-trixie AS dora-build
RUN git clone --filter=blob:none https://github.com/dora-rs/dora.git /dora-src \
    && git -C /dora-src checkout 06254f3d3353132f1184020d693680be4733bc2c \
    && cargo build --manifest-path /dora-src/Cargo.toml --release -p dora-cli

FROM ubuntu:24.04 AS opencv-calibration-build
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates cmake g++ git ninja-build \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth=1 --branch 5.0.0 https://github.com/opencv/opencv.git /opencv \
    && cmake -S /opencv -B /opencv-build -G Ninja \
       -DCMAKE_BUILD_TYPE=Release \
       -DCMAKE_INSTALL_PREFIX=/opt/opencv5 \
       -DBUILD_LIST=core,calib,geometry,imgcodecs,imgproc,objdetect \
       -DBUILD_opencv_apps=OFF \
       -DBUILD_PERF_TESTS=OFF \
       -DBUILD_TESTS=OFF \
       -DBUILD_EXAMPLES=OFF \
       -DBUILD_opencv_python3=OFF \
       -DWITH_CUDA=OFF \
       -DWITH_FFMPEG=OFF \
       -DWITH_GTK=OFF \
       -DWITH_IPP=OFF \
       -DWITH_OPENCL=OFF \
       -DWITH_QT=OFF \
    && cmake --build /opencv-build \
    && cmake --install /opencv-build

FROM moveit/moveit2:jazzy-release AS ros-base
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ros-jazzy-realsense2-camera \
    && rm -rf /var/lib/apt/lists/*

FROM rust:1.97-trixie AS perception-build
SHELL ["/bin/bash", "-c"]
RUN apt-get update \
    && apt-get install --yes --no-install-recommends clang cmake g++ libclang-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ros-base /opt/ros /opt/ros
COPY --from=opencv-calibration-build /opt/opencv5 /opt/opencv5
ENV OpenCV_DIR=/opt/opencv5/lib/cmake/opencv5 \
    LD_LIBRARY_PATH=/opt/opencv5/lib
WORKDIR /src
COPY backend/Cargo.toml backend/Cargo.lock ./
COPY backend/crates crates
COPY backend/nodes nodes
COPY tools/perception/assets /tools/perception/assets
RUN --mount=type=cache,id=robot-arm-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=robot-arm-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=robot-arm-perception-target,target=/src/target,sharing=locked \
    source /opt/ros/jazzy/setup.bash \
    && cargo build --release --locked -p perception-node \
       --no-default-features --features ros-runtime,opencv-runtime --bins \
    && cp /src/target/release/perception-node /perception-node \
    && cp /src/target/release/perception-calibration /perception-calibration

FROM ros-base
COPY --from=opencv-calibration-build /opt/opencv5 /opt/opencv5
ENV LD_LIBRARY_PATH=/opt/opencv5/lib:${LD_LIBRARY_PATH}
COPY --from=dora-build /dora-src/target/release/dora /usr/local/bin/dora
COPY --from=perception-build /perception-node /opt/robot-arm/bin/perception-node
COPY --from=perception-build /perception-calibration /opt/robot-arm/bin/perception-calibration
RUN /opt/robot-arm/bin/perception-calibration --self-test
COPY --chmod=755 backend/docker/perception-entrypoint.sh /usr/local/bin/perception-entrypoint
ENTRYPOINT ["/usr/local/bin/perception-entrypoint"]
