<?xml version="1.0"?>
<!--
  Star Arm 102-FL simulation candidate v1.

  The 6R transform chain is extracted from the upstream legacy Star Arm 102
  ROS2 description; limits are the FL product ranges expressed in the current
  FL plugin's logical signs.  This intentionally contains no transmissions,
  ros2_control block or actuator command interface.  It is simulation-only
  until the physical FL zero frames, axes, dimensions and TCP are measured.
-->
<robot name="stararm102_fl_sim_v1">
  <link name="base_link"/>
  <link name="link1"/>
  <link name="link2"/>
  <link name="link3"/>
  <link name="link4"/>
  <link name="link5"/>
  <link name="link6"/>
  <link name="tool0"/>

  <joint name="shoulder_pan" type="revolute">
    <parent link="base_link"/><child link="link1"/>
    <origin xyz="0 0 0.02835" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-1.9198621772" upper="1.9198621772" effort="0" velocity="1.0"/>
  </joint>
  <joint name="shoulder_lift" type="revolute">
    <parent link="link1"/><child link="link2"/>
    <origin xyz="0.0001 0 0.062025" rpy="-1.5707963268 0 3.1415926536"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="3.1415926536" effort="0" velocity="1.0"/>
  </joint>
  <joint name="elbow_flex" type="revolute">
    <parent link="link2"/><child link="link3"/>
    <origin xyz="0.1205653062 -0.0101 0.026" rpy="0 0 -1.5707963268"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-4.7123889804" upper="0" effort="0" velocity="1.0"/>
  </joint>
  <joint name="wrist_flex" type="revolute">
    <parent link="link3"/><child link="link4"/>
    <origin xyz="0.0162194771 -0.1076040562 -0.026" rpy="0 0 -1.5707963268"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-1.5707963268" upper="1.5707963268" effort="0" velocity="1.0"/>
  </joint>
  <joint name="wrist_yaw" type="revolute">
    <parent link="link4"/><child link="link5"/>
    <origin xyz="0.035 -0.00138 0" rpy="-1.5707963268 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-1.1344640138" upper="1.1344640138" effort="0" velocity="1.0"/>
  </joint>
  <joint name="wrist_roll" type="revolute">
    <parent link="link5"/><child link="link6"/>
    <origin xyz="0.15168 0 0.005225" rpy="-1.5708 0 -1.5708"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-2.6179938780" upper="2.6179938780" effort="0" velocity="1.0"/>
  </joint>
  <joint name="tool0_fixed" type="fixed">
    <parent link="link6"/><child link="tool0"/>
    <origin xyz="0.012325 0 -0.07313" rpy="1.5708 -1.5708 0"/>
  </joint>
</robot>
