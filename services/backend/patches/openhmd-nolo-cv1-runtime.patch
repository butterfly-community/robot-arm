 #include <stdio.h>
 #include "nolo.h"

+#define NOLO_GRAVITY_M_S2 9.80665f
+#define NOLO_CONTROLLER_ACCEL_COUNTS_PER_G 1024.0f
+#define NOLO_HMD_ACCEL_COUNTS_PER_G 16384.0f
+#define NOLO_GYRO_RADIANS_PER_SECOND_PER_COUNT ((2000.0f / 32768.0f) * (3.14159265358979323846f / 180.0f))
 #define DELTA 0x9e3779b9
 #define MX (((z>>5^y<<2) + (y>>3^z<<4)) ^ ((sum^y) + (key[(p&3)^e] ^ z)))

@@ -38,6 +42,39 @@ inline static uint32_t read32(const unsigned char** buffer)
 	return ret;
 }

+void nolo_sample_to_si(const nolo_sample* sample, nolo_imu_device device, vec3f* gyro, vec3f* accel)
+{
+	const float accel_counts_per_g = device == NOLO_IMU_CONTROLLER
+		? NOLO_CONTROLLER_ACCEL_COUNTS_PER_G
+		: NOLO_HMD_ACCEL_COUNTS_PER_G;
+	const float accel_scale = NOLO_GRAVITY_M_S2 / accel_counts_per_g;
+
+	/*
+	 * Converting NOLO's sensor coordinates reflects the raw Z axis. Acceleration
+	 * is a polar vector, but angular velocity is an axial vector and therefore
+	 * gains an additional determinant sign under a reflection. Controlled
+	 * hardware motion confirms this -X/-Y/+Z gyro relation to the transformed
+	 * accelerometer.  The scale is NOLO's +/-2000 degrees/second range divided
+	 * by the signed i16 range, converted to radians/second.
+	 */
+	gyro->x = -(float)sample->gyro[0] * NOLO_GYRO_RADIANS_PER_SECOND_PER_COUNT;
+	gyro->y = -(float)sample->gyro[1] * NOLO_GYRO_RADIANS_PER_SECOND_PER_COUNT;
+	gyro->z = (float)sample->gyro[2] * NOLO_GYRO_RADIANS_PER_SECOND_PER_COUNT;
+
+	accel->x = (float)sample->accel[0] * accel_scale;
+	accel->y = (float)sample->accel[1] * accel_scale;
+	accel->z = -(float)sample->accel[2] * accel_scale;
+}
+
+float nolo_ticks_to_seconds(uint64_t tick_delta, uint64_t ticks_per_second)
+{
+	if (ticks_per_second == 0) {
+		return 0.0f;
+	}
+
+	return tick_delta / (float)ticks_per_second;
+}
