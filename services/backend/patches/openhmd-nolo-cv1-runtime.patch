diff --git a/src/drv_nolo/nolo_fusion.c b/src/drv_nolo/nolo_fusion.c
new file mode 100644
index 0000000..00bfde7
--- /dev/null
+++ b/src/drv_nolo/nolo_fusion.c
@@ -0,0 +1,48 @@
+// Copyright 2026 OpenHMD contributors.
+// SPDX-License-Identifier: BSL-1.0
+
+#include "nolo_fusion.h"
+
+#define NOLO_GRAVITY_M_S2 9.80665f
+
+void nolo_fusion_init(nolo_fusion* fusion, float sample_rate_hz)
+{
+	FusionAhrsInitialise(&fusion->ahrs);
+	FusionAhrsSettings ahrs_settings = fusionAhrsDefaultSettings;
+	ahrs_settings.sampleRate = sample_rate_hz;
+	FusionAhrsSetSettings(&fusion->ahrs, &ahrs_settings);
+
+	FusionBiasInitialise(&fusion->bias);
+	FusionBiasSettings bias_settings = fusionBiasDefaultSettings;
+	bias_settings.sampleRate = sample_rate_hz;
+	FusionBiasSetSettings(&fusion->bias, &bias_settings);
+}
+
+quatf nolo_fusion_update(nolo_fusion* fusion, float dt, const vec3f* gyro_rad_s, const vec3f* accel_m_s2)
+{
+	FusionVector gyroscope = {{
+		FusionRadiansToDegrees(gyro_rad_s->x),
+		FusionRadiansToDegrees(gyro_rad_s->y),
+		FusionRadiansToDegrees(gyro_rad_s->z),
+	}};
+	const FusionVector accelerometer = {{
+		accel_m_s2->x / NOLO_GRAVITY_M_S2,
+		accel_m_s2->y / NOLO_GRAVITY_M_S2,
+		accel_m_s2->z / NOLO_GRAVITY_M_S2,
+	}};
+
+	gyroscope = FusionBiasUpdate(&fusion->bias, gyroscope);
+	if (dt > 0.0f) {
+		FusionAhrsSetSamplePeriod(&fusion->ahrs, dt);
+	}
+	FusionAhrsUpdateNoMagnetometer(&fusion->ahrs, gyroscope, accelerometer);
+
+	const FusionQuaternion orientation = FusionAhrsGetQuaternion(&fusion->ahrs);
+	const quatf result = {{
+		orientation.element.x,
+		orientation.element.y,
+		orientation.element.z,
+		orientation.element.w,
+	}};
+	return result;
+}
