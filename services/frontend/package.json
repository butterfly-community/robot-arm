{
  "name": "robot-arm-services-web",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "format:check": "prettier --check web tests *.config.ts components.json ../tests/integration/*.mjs",
    "format": "prettier --write web tests *.config.ts components.json ../tests/integration/*.mjs",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "pnpm -r --filter './web/apps/*' build"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.24",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.26"
    }
  }
}
