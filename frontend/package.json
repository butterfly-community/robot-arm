{
  "name": "robot-arm-services-web",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "format:check": "prettier --check web tests *.config.* components.json ../tests/integration/*.mjs",
    "format": "prettier --write web tests *.config.* components.json ../tests/integration/*.mjs",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "pnpm -r --filter './web/apps/*' build"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
