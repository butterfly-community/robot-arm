# syntax=docker/dockerfile:1.7
FROM node:24-trixie-slim AS build
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@11.24.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY web/apps/arm-execution/package.json web/apps/arm-execution/package.json
COPY web/apps/motion/package.json web/apps/motion/package.json
COPY web/apps/spatial/package.json web/apps/spatial/package.json
COPY web/apps/tracking/package.json web/apps/tracking/package.json
COPY web/packages/contracts/package.json web/packages/contracts/package.json
COPY web/packages/gateway-client/package.json web/packages/gateway-client/package.json
COPY web/packages/ui/package.json web/packages/ui/package.json
COPY web/packages/visualization/package.json web/packages/visualization/package.json
RUN pnpm install --frozen-lockfile
COPY web web
RUN pnpm -r --filter './web/apps/*' build
RUN set -eu; \
    for app in tracking spatial motion arm-execution; do \
      destination="/runtime/$app"; \
      mkdir -p "$destination/web/apps/$app/.next"; \
      cp -a "web/apps/$app/.next/standalone/." "$destination/"; \
      cp -a "web/apps/$app/.next/static" "$destination/web/apps/$app/.next/static"; \
    done

FROM node:24-trixie-slim
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
WORKDIR /app
COPY --from=build /runtime /runtime
CMD ["sh", "-c", "exec node /runtime/${WEB_APP}/web/apps/${WEB_APP}/server.js"]
